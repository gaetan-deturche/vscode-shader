{
	"name": "shaderG2",
	"displayName": "Shader languages support for VS Code",
	"description": "Syntax highlighter for shader language (hlsl, glsl, cg) ",
	"version": "1.4.0",
	"publisher": "slevesque-G2",
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:hlsl",
		"onLanguage:glsl",
		"onLanguage:cg"
	],
	"main": "./dist/extension",
	"license": "LICENSE.md",
	"icon": "icon.png",
	"bugs": {
		"url": "https://github.com/stef-levesque/vscode-shader/issues"
	},
	"homepage": "https://github.com/stef-levesque/vscode-shader/blob/master/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/stef-levesque/vscode-shader.git"
	},
	"galleryBanner": {
		"color": "#5c2d91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.53.0"
	},
	"keywords": [
		"shader",
		"hlsl",
		"glsl",
		"Cg"
	],
	"contributes": {
		"commands": [
			{
				"command": "shader.refreshSymbols",
				"title": "Shader: Refresh Symbols"
			}
		],
		"languages": [
			{
				"id": "hlsl",
				"extensions": [
					".sf",
					".ush"
				]
			},
			{
				"id": "glsl",
				"aliases": [
					"GLSL",
					"OpenGL Shading Language",
					"glsl"
				],
				"extensions": [
					".vs",
					".fs",
					".gs",
					".vsf",
					".fsh",
					".gsh",
					".vshader",
					".fshader",
					".gshader",
					".comp",
					".vert",
					".tesc",
					".tese",
					".frag",
					".geom",
					".glsl",
					".glslv",
					".glslf",
					".glslg"
				],
				"configuration": "./glsl.configuration.json"
			},
			{
				"id": "cg",
				"aliases": [
					"Cg",
					"C for Graphics",
					"cg"
				],
				"extensions": [
					".cg"
				],
				"configuration": "./cg.configuration.json"
			}
		],
		"grammars": [
			{
				"language": "glsl",
				"scopeName": "source.glsl",
				"path": "./syntaxes/glsl.tmLanguage"
			},
			{
				"language": "cg",
				"scopeName": "source.cg",
				"path": "./syntaxes/cg.tmLanguage"
			},
			{
				"scopeName": "text.html.glsl",
				"path": "./syntaxes/glsl-html.tmLanguage.json",
				"injectTo": [
					"text.html"
				],
				"embeddedLanguages": {
					"source.glsl": "glsl"
				}
			},
			{
				"scopeName": "source.cpp.glsl",
				"path": "./syntaxes/glsl-cpp.tmLanguage.json",
				"injectTo": [
					"source.cpp"
				],
				"embeddedLanguages": {
					"source.glsl": "glsl"
				}
			},
			{
				"scopeName": "source.cpp.hlsl",
				"path": "./syntaxes/hlsl-cpp.tmLanguage.json",
				"injectTo": [
					"source.cpp"
				],
				"embeddedLanguages": {
					"source.hlsl": "hlsl"
				}
			},
			{
				"scopeName": "source.cpp.cg",
				"path": "./syntaxes/cg-cpp.tmLanguage.json",
				"injectTo": [
					"source.cpp"
				],
				"embeddedLanguages": {
					"source.cg": "cg"
				}
			}
		],
		"configuration": {
			"title": "VS Code Shader Configuration",
			"type": "object",
			"properties": {
				"hlsl.suggest.basic": {
					"type": "boolean",
					"default": true,
					"description": "Configures if the extension HLSL language suggestions are enabled."
				},
				"hlsl.openDocOnSide": {
					"type": "boolean",
					"default": true,
					"description": "Open the HLSL Documentation links on the side"
				},
				"hlsl.parser": {
					"type": "string",
					"enum": [
						"regex",
						"ast"
					],
					"enumItemLabels": [
						"Regex (fast)",
						"AST (accurate, default)"
					],
					"enumDescriptions": [
						"Fast regex/ripgrep symbol extraction. Lightweight, but name-only and unaware of scope.",
						"AST-based parser: scope-aware go-to-definition, struct member completion after '.', and typed hover/signature help."
					],
					"default": "ast",
					"markdownDescription": "Symbol engine used for HLSL navigation and completion.\n\n- **AST** — parses files into a syntax tree for scope-aware results (default).\n- **Regex** — fast, name-based matching.\n\n_Changing this requires reloading the window._",
					"order": 1
				},
				"hlsl.ast.swizzleCompletion": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "When `#hlsl.parser#` is set to **AST**, offer vector swizzle members (`.xyzw` / `.rgba`) on `float`/`half`/`int`/`uint` vector types.",
					"order": 2
				},
				"hlsl.ast.excludeDirs": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"node_modules",
						".git",
						"Saved",
						"Intermediate",
						"Binaries",
						"DerivedDataCache"
					],
					"markdownDescription": "When `#hlsl.parser#` is set to **AST**, directory names excluded from workspace symbol indexing (matched as a full path segment, anywhere in the tree). Build-artifact folders such as Unreal's `Saved`/`Intermediate` hold thousands of generated shaders and should stay excluded to keep indexing fast and memory low.",
					"order": 3
				},
				"hlsl.ast.unrealUniformBuffers": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "When `#hlsl.parser#` is set to **AST**, also scan C++ (`.h`/`.cpp`/`.inl`) for Unreal Engine shader-parameter / uniform-buffer structs (`BEGIN_*_SHADER_PARAMETER_STRUCT`, `SHADER_PARAMETER(...)`, `UNIFORM_MEMBER(...)`). Their members are indexed so go-to-definition and find-references on a uniform member jump to the C++ declaration. Requires ripgrep (bundled with VS Code).",
					"order": 4
				}
			}
		}
	},
	"scripts": {
		"compile": "npm run check-types && node esbuild.mjs",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.mjs --production",
		"vsix": "vsce package --out shaderG2.vsix",
		"copy-vsix": "node -e \"const fs=require('fs');const v=require('./package.json').version;fs.copyFileSync('shader-'+v+'.vsix','../shader-'+v+'.vsix');console.log('Copied to parent folder')\""
	},
	"devDependencies": {
		"@types/node": "^12.18.3",
		"@types/tmp": "^0.2.0",
		"@types/vscode": "^1.53",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.27.3",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.6.2"
	},
	"dependencies": {
		"follow-redirects": "^1.5.8",
		"glob": "^10.4.5",
		"jsdom": "^24.1.3",
		"lru-cache": "^8.0.4",
		"minimatch": "^9.0.4",
		"sql.js": "^1.14.1",
		"tmp": "^0.2.5"
	}
}
